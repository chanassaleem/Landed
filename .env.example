# Copy to .env and fill in. .env is gitignored and must stay that way.

# The project URL and its PUBLIC key. Safe to expose: every request the
# key makes is still subject to row-level security.
#
# Supabase replaced the anon key with a publishable key (sb_publishable_…)
# and is retiring the old one. Set whichever your project has; if both
# are set the publishable key is used.
SUPABASE_URL=https://hyqutwoymrepdxqouyru.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# NOT USED BY THIS APP, and listed only so nobody adds it by habit.
#
# The secret key (sb_secret_…), and the service_role key it replaces,
# run as a role with BYPASSRLS: they ignore every policy in
# supabase/migrations. Nothing here needs that -- the server reaches
# Postgres through DATABASE_URL and scopes each request with as_user --
# so leaving it unset removes a way for it to leak.

# Direct Postgres connection, for migrations and the RLS test suite.
LANDED_TEST_DSN=
